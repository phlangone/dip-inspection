#!/usr/bin/python3
"""Optional privileged helper. Accepts validated Wi-Fi operations over stdin; no command-line arguments."""
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import uuid

NMC='/usr/bin/nmcli'
IP='/usr/sbin/ip' if os.path.exists('/usr/sbin/ip') else '/usr/bin/ip'


def nm(args):
    result=subprocess.run([NMC,'--wait','10',*args],capture_output=True,text=True,timeout=15,env={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','LC_ALL':'C'})
    if result.returncode:
        raise ValueError('Operação Wi-Fi recusada pelo NetworkManager.')
    return result.stdout.strip()


def check_profile(profile, interface):
    if str(uuid.UUID(profile))!=profile:
        raise ValueError('UUID inválido.')
    if nm(['-g','connection.type','connection','show','uuid',profile])!='802-11-wireless':
        raise ValueError('Perfil não é Wi-Fi.')
    if nm(['-g','connection.interface-name','connection','show','uuid',profile])!=interface:
        raise ValueError('Interface do perfil inválida.')
    if not nm(['-g','connection.id','connection','show','uuid',profile]).startswith('futurecom-wifi-'):
        raise ValueError('Perfil não foi criado pelo painel.')


def main():
    if len(sys.argv)!=1 or os.geteuid()!=0 or not os.environ.get('SUDO_UID'):
        raise ValueError('Invocação inválida.')
    interface=open('/etc/futurecom-wifi-interface',encoding='ascii').read().strip()
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,32}',interface):
        raise ValueError('Interface inválida.')
    if nm(['-g','GENERAL.TYPE','device','show',interface])!='wifi':
        raise ValueError('Interface autorizada não é Wi-Fi.')
    request=json.loads(sys.stdin.read(4097))
    args=request.get('args')
    if not isinstance(args,list) or len(args)>40 or any(not isinstance(v,str) or len(v)>512 or '\x00' in v for v in args):
        raise ValueError('Pedido inválido.')
    if args==['device','wifi','rescan','ifname',interface]:
        return nm(args)
    # Recheck the route in the privileged context.
    import ipaddress
    host=str(ipaddress.ip_address(request.get('robot_host','')))
    routes=subprocess.run([IP,'-j','route','get',host],capture_output=True,text=True,timeout=3)
    data=json.loads(routes.stdout) if routes.returncode==0 else []
    if not data or data[0].get('dev')==interface:
        raise ValueError('Rota do robô usa Wi-Fi ou não foi verificada.')
    if args==['device','disconnect',interface]:
        return nm(args)
    if args[:2]==['connection','add']:
        prefix=['connection','add','type','wifi','ifname',interface,'con-name']
        if args[:7]!=prefix or len(args)!=22:
            raise ValueError('Criação de perfil inválida.')
        name,ssid,profile=args[7],args[9],args[11]
        if args[8]!='ssid' or args[10]!='connection.uuid' or str(uuid.UUID(profile))!=profile or name!='futurecom-wifi-'+profile[:8]:
            raise ValueError('Identificação de perfil inválida.')
        if not 1<=len(ssid.encode())<=32 or any(c in ssid for c in '\r\n\x00'):
            raise ValueError('SSID inválido.')
        suffix=['connection.autoconnect','no','ipv4.method','auto','ipv4.never-default','yes','ipv6.method','auto','ipv6.never-default','yes']
        if args[12:]!=suffix:
            raise ValueError('Propriedades não autorizadas.')
        return nm(args)
    if args[:3] not in (['connection','modify','uuid'],['connection','up','uuid'],['connection','delete','uuid']):
        raise ValueError('Comando não autorizado.')
    if len(args)<4: raise ValueError('Perfil ausente.')
    profile=args[3];check_profile(profile,interface)
    if args[:2]==['connection','modify']:
        if args[4:] not in (['wifi-sec.key-mgmt','wpa-psk','wifi-sec.psk-flags','0'],['connection.autoconnect','yes']):
            raise ValueError('Modificação não autorizada.')
        return nm(args)
    if args[:2]==['connection','delete'] and len(args)==4:
        return nm(args)
    if args[:2]==['connection','up'] and args[4:6]==['ifname',interface]:
        if len(args)==6:return nm(args)
        if len(args)!=8 or args[6]!='passwd-file':raise ValueError('Ativação inválida.')
        source=args[7];parent=os.path.dirname(source);uid=int(os.environ['SUDO_UID'])
        if os.path.realpath(parent)!=parent or not os.path.basename(parent).startswith('futurecom-wifi-'):
            raise ValueError('Arquivo de credenciais inválido.')
        directory=os.stat(parent,follow_symlinks=False)
        if not stat.S_ISDIR(directory.st_mode) or directory.st_uid!=uid or stat.S_IMODE(directory.st_mode)!=0o700:
            raise ValueError('Diretório de credenciais inválido.')
        fd=os.open(source,os.O_RDONLY|os.O_NOFOLLOW)
        with os.fdopen(fd,'r') as stream:
            info=os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid!=uid or stat.S_IMODE(info.st_mode)!=0o600:
                raise ValueError('Permissões de credenciais inválidas.')
            contents=stream.read(1025)
        if len(contents)>1024 or not contents.startswith('802-11-wireless-security.psk:') or contents.count('\n')!=1 or not contents.endswith('\n'):
            raise ValueError('Conteúdo de credenciais inválido.')
        password=contents.partition(':')[2][:-1]
        if '\r' in password or '\x00' in password or not (8<=len(password)<=63 or (len(password)==64 and re.fullmatch('[0-9a-fA-F]+',password))):
            raise ValueError('Senha inválida.')
        with tempfile.TemporaryDirectory(prefix='futurecom-root-wifi-') as folder:
            target=os.path.join(folder,'credentials')
            fd=os.open(target,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
            with os.fdopen(fd,'w') as stream:stream.write(contents)
            return nm(args[:7]+[target])
    raise ValueError('Pedido não autorizado.')


if __name__=='__main__':
    try:
        print(main())
    except Exception:
        # Do not print tracebacks, arguments, or credentials.
        print('Helper Wi-Fi recusou a operação.',file=sys.stderr)
        sys.exit(1)
